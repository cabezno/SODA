{
  "npm_heuristics": {
    "wrong_package_names": {
      "@framer-motion/framer-motion": "framer-motion",
      "@react-router/react-router": "react-router",
      "@axios/axios": "axios",
      "@lodash/lodash": "lodash"
    },
    "version_corrections": {
      "@types/jest": "^29.5.0",
      "@types/node": "^20.0.0",
      "@types/react": "^18.0.0",
      "@types/react-dom": "^18.0.0",
      "@types/express": "^4.17.0",
      "@types/lodash": "^4.14.0",
      "@types/uuid": "^9.0.0",
      "nodemailer": "^6.9.0",
      "next-auth": "^4.24.0",
      "@electron-toolkit/preload": "^3.0.0",
      "@electron-toolkit/utils": "^3.0.0"
    }
  },
  "js_ts_heuristics": {
    "public_interface_patterns": [
      "export\\s+(class|interface|type|const|function|async\\s+function)\\s+\\w+",
      "class\\s+\\w+",
      "interface\\s+\\w+",
      "function\\s+\\w+\\s*\\(.*?\\)"
    ]
  }
}
