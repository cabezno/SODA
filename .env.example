# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear .env

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OLLAMA_BASE_URL=http://localhost:11434

# Perplexity API — web research en tiempo real (WebResearcher)
# Obtené una key en https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# OpenAI — proveedor opcional
# OPENAI_API_KEY=sk-...

# Opcional (Fase B+)
# GITHUB_TOKEN=ghp_...

# Telegram Bot (Fase G) — get token from @BotFather
# TELEGRAM_BOT_TOKEN=123456789:AAF...

# Runtimes aislados (Docker)
# Si se pone en false, SODA fallará si intenta ejecutar comandos en el host directamente.
USE_LOCAL_RUNTIMES=true
